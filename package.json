{
  "name": "workix-graphql",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "create": "npx sequelize db:create",
    "create:test": "npx sequelize db:create --env=test",
    "drop": "npx sequelize db:drop",
    "drop:test": "npx sequelize db:drop --env=test",
    "migrate": "npx sequelize db:migrate",
    "migrate:test": "npx sequelize db:migrate --env=test",
    "seed": "npx sequelize db:seed:all",
    "seed:test": "npx sequelize db:seed:all --env=test --debug",
    "seed:sqlite": "ts-node src/seeders/populate_all_dummy_data.ts",
    "prestart": "npm run seed:sqlite",
    "start": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "typecheck": "tsc --noEmit",
    "serve": "node dist/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
