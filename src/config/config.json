{
  "development": {
    "dialect": "sqlite",
    "storage": "./database.sqlite",
    "migrationStorage": "sequelize",
    "seederStorage": "sequelize",
    "define": {
      "timestamps": false,
      "underscored": true
    },
    "pool": {
      "max": 5,
      "min": 1,
      "idle": 10000,
      "acquire": 20000
    },
    "logging": false
  },
  "test": {
    "dialect": "sqlite",
    "storage": "./database_test.sqlite",
    "migrationStorage": "sequelize",
    "seederStorage": "sequelize",
    "define": {
      "timestamps": false,
      "underscored": true
    },
    "pool": {
      "max": 5,
      "min": 1,
      "idle": 10000,
      "acquire": 20000
    },
    "logging": false
  },
  "production": {
    "use_env_variable": "DATABASE_URL",
    "dialect": "postgres",
    "protocol": "postgres",
    "pool": {
      "max": 20,
      "min": 2,
      "idle": 10000,
      "acquire": 30000,
      "evict": 1000
    },
    "dialectOptions": {
      "multipleStatements": true,
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      },
      "migrationStorage": "sequelize",
      "seederStorage": "sequelize",
      "define": {
        "timestamps": false,
        "underscored": true
      }
    }
  }
}