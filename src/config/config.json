{
  "development": {
    "dialect": "sqlite",
    "storage": "./database.sqlite",
    "migrationStorage": "sequelize",
    "seederStorage": "sequelize",
    "define": {
      "timestamps": false,
      "underscored": true
    },
    "logging": false
  },
  "test": {
    "dialect": "sqlite",
    "storage": "./database_test.sqlite",
    "migrationStorage": "sequelize",
    "seederStorage": "sequelize",
    "define": {
      "timestamps": false,
      "underscored": true
    },
    "logging": false
  },
  "production": {
    "use_env_variable": "DATABASE_URL",
    "dialect": "postgres",
    "protocol": "postgres",
    "dialectOptions": {
      "multipleStatements": true,
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      },
      "migrationStorage": "sequelize",
      "seederStorage": "sequelize",
      "define": {
        "timestamps": false,
        "underscored": true
      }
    }
  }
}