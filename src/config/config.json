{
  "development": {
    "username": "postgres",
    "password": "postgres",
    "database": "workix",
    "host": "127.0.0.1",
    "dialect": "postgres",
    "migrationStorage": "sequelize",
    "seederStorage": "sequelize",
    "define": {
      "timestamps": false,
      "underscored": true
    },
    "dialectOptions": {
      "multipleStatements": true
    }
  },
  "test": {
    "username": "postgres",
    "password": "postgres",
    "database": "workix_test",
    "host": "127.0.0.1",
    "dialect": "postgres",
    "migrationStorage": "sequelize",
    "seederStorage": "sequelize",
    "define": {
      "timestamps": false,
      "underscored": true
    },
    "dialectOptions": {
      "multipleStatements": true
    }
  },
  "production": {
    "use_env_variable": "DATABASE_URL",
    "dialect": "postgres",
    "protocol": "postgres",
    "dialectOptions": {
      "multipleStatements": true,
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      },
      "migrationStorage": "sequelize",
      "seederStorage": "sequelize",
      "define": {
        "timestamps": false,
        "underscored": true
      }
    }
  }
}